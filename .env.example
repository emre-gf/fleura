# Fleura Nails — ortam değişkenleri (gerçek değerleri .env dosyasına yazın; .env git'e girmez)

# Site kök adresi (sitemap ve IndexNow için)
SITE_URL=https://www.fleura.com.tr

# IndexNow (Bing, Yandex, Naver, Seznam) — https://www.indexnow.org/
# 8-128 karakter, sadece a-z A-Z 0-9 ve tire. Örn: openssl rand -hex 16
# Anahtar tasarım gereği herkese açıktır: `npm run seo:indexnow:keyfile` komutu köke <ANAHTAR>.txt
# dosyasını üretir; bu dosya yayına çıkmalıdır (commit edilebilir). Gizli tutulması gereken şey bu .env dosyasıdır.
INDEXNOW_KEY=
# İsteğe bağlı: anahtar dosyası farklı bir yerde barındırılıyorsa tam URL
INDEXNOW_KEY_LOCATION=

# Bing Webmaster Tools doğrulaması: <meta name="msvalidate.01" content="..."> için değer.
# Bu değeri .env'e yazdıktan sonra `npm run seo:bing-meta` ile sayfa head'lerine işlenir.
# Not: Bing, Google Search Console'dan tek tıkla içe aktarmayı da destekler (alternatif yol).
BING_SITE_VERIFICATION=
